CEREBRAS_API_KEY=
CEREBRAS_API_KEY_FAST=
CEREBRAS_API_KEY_THIRD=
CEREBRAS_API_KEY_USE_CASE=
CEREBRAS_API_KEY_PRESENTATION=
CEREBRAS_API_KEY_COMPARISON=
AI_BASE_URL=https://api.cerebras.ai/v1
AI_MODEL=gpt-oss-120b
JWT_SECRET=replace_with_a_long_random_secret
MAX_TRANSCRIPT_CHARS=28000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin

# Local SQLite by default. On Render, set DATABASE_URL from the Postgres instance.
DATABASE_URL=sqlite:///./synopsis.db

# Node caption microservice (recommended for production on Render)
CAPTION_SERVICE_URL=http://127.0.0.1:3001
CAPTION_SERVICE_SECRET=

# Optional residential/datacenter proxy for YouTube requests
# Example: http://username:password@proxy.webshare.io:80
WEBSHARE_PROXY_URL=

# Comma-separated frontend URLs allowed by CORS
# Example: https://your-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
